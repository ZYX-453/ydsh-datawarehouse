# 默认：文本文件自动识别换行符，仓库内统一存 LF
* text=auto eol=lf

# SQL 脚本强制 LF（Hive / beeline 对 CRLF 敏感）
*.sql text eol=lf
*.sh  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown 与文档
*.md  text eol=lf

# CSV 是原始数据，按二进制处理，禁止 Git 改动换行符
*.csv binary

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
